# ======================= Backend (NestJS) =======================
# Secret used to sign the JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-in-production

# Database — zero-config SQLite (sql.js) by default (leave empty). For Postgres /
# prod parity:  DATABASE_URL=postgres://notes:notes@localhost:5432/notes
DATABASE_URL=

# Frontend origin — used for CORS (credentialed requests) and the cookie's site.
FRONTEND_ORIGIN=http://localhost:3000

# JWT cookie auth (httpOnly access + refresh)
JWT_COOKIE_SECURE=false           # defaults to true in production; set false only for HTTP dev
JWT_COOKIE_SAMESITE=Lax           # use "None" (with JWT_COOKIE_SECURE=true) for cross-domain FE/API
JWT_ACCESS_TTL_MIN=15             # access-token lifetime (client silently refreshes on 401)
JWT_REFRESH_TTL_DAYS=7            # refresh-token lifetime

# Set only when the API runs behind a reverse proxy (nginx, a load balancer), so
# the client IP for rate limiting is read from X-Forwarded-For. Value: hop count
# or "true". Leave unset for a directly-exposed API (can't be spoofed).
# TRUST_PROXY=1

# ======================= AI assist (optional) =======================
# OpenAI-compatible seam — Groq by default. The feature degrades gracefully to a
# keyword heuristic when LLM_API_KEY is empty, so the app runs fine without it.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=                      # free Groq key (gsk_...) from https://console.groq.com
LLM_CLASSIFIER_MODEL=llama-3.1-8b-instant
LLM_GENERATOR_MODEL=llama-3.3-70b-versatile

# ======================= Frontend (Next.js) =======================
# Browser-side base URL for the API
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Server-side (route handlers / SSR) API base — internal host in Docker
API_URL=http://localhost:8000/api
