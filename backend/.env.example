# Copy to `.env` for local development. All values have safe defaults.

# --- Server ---------------------------------------------------------------
PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# --- Database -------------------------------------------------------------
# Leave DATABASE_URL empty to use zero-config SQLite (sql.js). Set it to a
# Postgres URL for prod parity, e.g. postgres://notes:notes@db:5432/notes
DATABASE_URL=

# --- Auth (JWT in httpOnly cookies) ---------------------------------------
JWT_SECRET=dev-insecure-change-me-in-prod
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax

# --- AI assist (optional) — OpenAI-compatible seam, Groq by default -------
# With no key the app still works via a keyword heuristic fallback.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_CLASSIFIER_MODEL=llama-3.1-8b-instant
LLM_GENERATOR_MODEL=llama-3.3-70b-versatile
